# ===== App =====
CORS_ORIGINS=http://localhost:3000        # comma-separated exact origins; "*" is ignored on purpose
DOCS_ENABLED=true                         # set false in production (hides /docs, /openapi.json)
ENABLE_HSTS=false                         # true ONLY when served over HTTPS end to end

# ===== Size limits =====
MAX_IMAGE_MB=10
MAX_VIDEO_MB=100                          # keep >= clamd StreamMaxLength if scanning videos
MAX_TEXT_CHARS=20000
MIN_TEXT_CHARS=50

# ===== Image safety =====
MAX_IMAGE_PIXELS=40000000                 # decoded width*height
MAX_IMAGE_DIMENSION=10000                 # max width or height
IMAGE_NORMALIZE_MAX_SIDE=2048             # accepted images are downscaled to this before inference

# ===== Temporary storage =====
TEMP_UPLOAD_DIR=                          # empty = <system tmp>/ayf-uploads (created 0700; files 0600, deleted after every request)

# ===== Rate limiting (per client IP, per endpoint) =====
RATE_LIMIT_IMAGE_PER_MIN=20
RATE_LIMIT_VIDEO_PER_MIN=5
RATE_LIMIT_TEXT_PER_MIN=30
RATE_LIMIT_WINDOW_S=60
RATE_LIMIT_BACKEND=memory                 # memory (single process) | redis (multiple workers/instances)
REDIS_URL=                                # e.g. redis://redis:6379/0
TRUSTED_PROXY_COUNT=0                     # reverse proxies in front of the app; 0 = ignore X-Forwarded-For

# ===== Concurrency and timeouts =====
MAX_CONCURRENT_UPLOADS=4
MAX_CONCURRENT_IMAGE_INFERENCE=2
MAX_CONCURRENT_VIDEO_INFERENCE=1
MAX_CONCURRENT_TEXT_INFERENCE=2
QUEUE_WAIT_TIMEOUT_S=5                    # wait for an inference slot, then 503
INFERENCE_TIMEOUT_IMAGE_S=30
INFERENCE_TIMEOUT_VIDEO_S=300
INFERENCE_TIMEOUT_TEXT_S=30

# ===== Malware scanning (ClamAV clamd) =====
MALWARE_SCAN_MODE=off                     # off = NOT scanned (dev only) | optional = scan if available | required = fail closed
CLAMD_HOST=127.0.0.1
CLAMD_PORT=3310
CLAMD_SOCKET=                             # unix socket path; overrides host/port when set
SCAN_TIMEOUT_S=30

# ===== Model =====
INCONCLUSIVE_BAND=0.10
IMAGE_MODEL_PATH=models/DeepFake_Image_Detection_v1.pth
IMAGE_MODEL_NAME=DeepFakeImage v1 (ResNet-18)
IMAGE_FAKE_CLASS_INDEX=1
DEVICE=cpu


HF_MODEL_REPO=not-human-s1/areyouforged.com
HF_TOKEN=
DEVICE=auto
IMAGE_FAKE_THRESHOLD=0.40